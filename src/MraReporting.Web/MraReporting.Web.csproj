<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Targets .NET 10. For .NET 8, change net10.0 to net8.0 here
         and the Negotiate package version below from 10.* to 8.*. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MraReporting</RootNamespace>
    <!-- Links to the SQL login saved with 'dotnet user-secrets' on the developer's PC. Keep this line. -->
    <UserSecretsId>0375b5dc-c351-40de-afbd-835bb05aaead</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- All packages are free (MIT or Apache 2.0). Floating versions pick the
         latest release on first restore; pin them once the build is green. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.*" />
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.*-*" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Negotiate" Version="10.*" />
    <PackageReference Include="ClosedXML" Version="0.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.*" />
    <PackageReference Include="ScottPlot" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- MRA logo for the header of summary report PDFs, built into the app so it always travels with it. -->
    <EmbeddedResource Include="Assets\mra-logo.png" LogicalName="MraReporting.mra-logo.png" />
  </ItemGroup>

</Project>
