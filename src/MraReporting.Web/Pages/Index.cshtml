@page
@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var displayName = User.FindFirst(MraReporting.Auth.AppClaims.DisplayName)?.Value ?? User.Identity?.Name ?? "";
    var userName = User.Identity?.Name ?? "";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var canSignOut = User.FindFirst(MraReporting.Auth.AppClaims.DisplayName) is not null; // app accounts only
    var nameParts = displayName.Split(new[] { ' ', '.', '_', '-', '\\' }, StringSplitOptions.RemoveEmptyEntries);
    var initials = string.Concat(nameParts.Take(2).Select(w => char.ToUpperInvariant(w[0])));
    var firstName = canSignOut && nameParts.Length > 0 ? nameParts[0] : "";
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#0B391B">
    <title>MRA Reporting Assistant</title>
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" href="/img/favicon.png">
    <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
    <link rel="preload" href="/lib/fonts/public-sans.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/css/site.css?v=30">
</head>
<body data-first-name="@firstName">
<div class="shell" id="shell">

    <!-- Left navigation: new conversation, summary report, saved conversations, the signed-in user -->
    <aside class="rail" id="rail" aria-label="Navigation">
        <div class="rail-head">
            <div class="identity-text">
                <p class="app-name">Reporting Assistant</p>
                <p class="app-sub">Ask about revenue data</p>
            </div>
            <div class="rail-tools">
            <button type="button" class="icon-btn icon-btn-light" id="search-btn" aria-haspopup="dialog" aria-label="Search conversations (Ctrl+K)" title="Search conversations (Ctrl+K)">
                <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M16 16l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
            <button type="button" class="icon-btn icon-btn-light" id="rail-toggle" aria-controls="rail" aria-expanded="true" aria-label="Close the side panel" title="Close the side panel">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M9.5 4.5v15" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            </button>
            </div>
        </div>

        <div class="rail-actions">
            <button type="button" id="new-chat" class="nav-btn nav-btn-primary" title="New conversation">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M12 5v14M5 12h14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
                <span class="nav-label">New conversation</span>
            </button>
            <button type="button" id="open-report" class="nav-btn" title="Summary report">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 3h7l5 5v13H7z" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/><path d="M14 3v5h5M10 13h6M10 17h6" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
                <span class="nav-label">Summary report</span>
            </button>
        </div>

        <nav class="history" aria-label="Your conversations">
            <div id="history-list" class="history-list"></div>
            <p class="history-empty" id="history-empty">Your conversations will be saved here.</p>
        </nav>

        @if (signedIn)
        {
            <div class="user-menu" id="user-menu">
                <button type="button" class="user-chip" id="user-chip" aria-haspopup="menu" aria-expanded="false" aria-controls="user-pop">
                    <span class="user-initials" aria-hidden="true">@initials</span>
                    <span class="user-text">
                        <span class="user-name">@displayName</span>
                        @if (role.Length > 0) { <span class="user-role">@role</span> }
                    </span>
                    <svg class="user-chevron" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 14l5-5 5 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </button>
                <div class="user-pop" id="user-pop" role="menu" hidden>
                    <div class="user-pop-head">
                        <span class="user-pop-name">@displayName</span>
                        <span class="user-pop-id">@userName</span>
                    </div>
                    <button type="button" role="menuitem" class="user-pop-item" id="clear-history">Delete all conversations</button>
                    @if (canSignOut)
                    {
                        <form method="post" action="/logout">
                            <button type="submit" role="menuitem" class="user-pop-item user-pop-signout">Sign out</button>
                        </form>
                    }
                </div>
            </div>
        }
    </aside>
    <div class="scrim" id="scrim" hidden></div>

    <!-- Conversation -->
    <main class="desk empty">
        <header class="desk-bar">
            <button type="button" class="icon-btn phone-only" id="rail-open" aria-controls="rail" aria-label="Open the side panel" title="Open the side panel">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><rect x="3.5" y="4.5" width="17" height="15" rx="2" fill="none" stroke="currentColor" stroke-width="1.7"/><path d="M9.5 4.5v15" fill="none" stroke="currentColor" stroke-width="1.7"/></svg>
            </button>
            <h1 class="desk-title" id="desk-title"></h1>
        </header>

        <div id="messages" class="messages" aria-live="polite">
            <section class="welcome" id="welcome" aria-labelledby="welcome-title">
                <h2 id="welcome-title">Hello</h2>
                <p class="welcome-lead" id="welcome-lead">What would you like to know? Ask in plain words, and every answer comes with the table it was taken from.</p>
            </section>
        </div>

        <form id="ask-form" class="composer">
            <div class="composer-box">
                <textarea id="question" rows="1" maxlength="1000"
                          placeholder="Ask a question"
                          aria-label="Your question"></textarea>
                <button type="submit" id="send" class="btn btn-primary">Ask</button>
            </div>
            <p class="composer-hint">Press Enter to ask, Shift and Enter for a new line.</p>
        </form>
    </main>
</div>

<!-- Summary report: its own window, so the dates and calendar have room -->
<dialog class="report-dialog" id="report-dialog" aria-labelledby="report-dialog-title">
    <div class="report-dialog-head">
        <h2 id="report-dialog-title">Summary report</h2>
        <form method="dialog">
            <button type="submit" class="icon-btn" aria-label="Close" title="Close">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </form>
    </div>
    <p class="report-dialog-lead">Headline figures, trends, VAT by rate and office, top taxpayers, customs payments and red flags for any period up to 400 days.</p>

    <div class="report-dates">
        <label>
            <span>From</span>
            <input type="date" id="report-from">
        </label>
        <label>
            <span>To</span>
            <input type="date" id="report-to">
        </label>
    </div>

    <div class="dl dl-block report-download">
        <button type="button" class="btn btn-primary dl-toggle" aria-haspopup="menu" aria-expanded="false">Download report</button>
        <div class="dl-menu" role="menu" hidden>
            <a role="menuitem" id="report-xlsx" href="#">Excel <span>.xlsx</span></a>
            <a role="menuitem" id="report-docx" href="#">Word <span>.docx</span></a>
            <a role="menuitem" id="report-pdf" href="#">PDF <span>.pdf</span></a>
        </div>
    </div>
    <p class="report-dialog-hint">Longer periods take a minute or two to build. You can also ask in the chat, for example "report for January 2026".</p>
</dialog>

<!-- Search: a pop-up window over the page -->
<dialog class="search-dialog" id="search-dialog" aria-label="Search conversations">
    <div class="search-head">
        <input type="search" id="search-input" placeholder="Search..." aria-label="Search your conversations" autocomplete="off" spellcheck="false">
        <button type="button" class="search-clear-text" id="search-clear" hidden>Clear</button>
        <span class="search-divider" aria-hidden="true"></span>
        <form method="dialog">
            <button type="submit" class="icon-btn" aria-label="Close search" title="Close">
                <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
            </button>
        </form>
    </div>
    <div class="search-tabs" id="search-tabs" role="tablist" aria-label="Where to search" hidden>
        <button type="button" role="tab" class="search-tab active" data-kind="all" aria-selected="true">All</button>
        <button type="button" role="tab" class="search-tab" data-kind="question" aria-selected="false">Questions</button>
        <button type="button" role="tab" class="search-tab" data-kind="answer" aria-selected="false">Answers</button>
        <button type="button" role="tab" class="search-tab" data-kind="table" aria-selected="false">Tables</button>
    </div>
    <p class="search-label" id="search-label">Recent conversations</p>
    <ul class="search-results" id="search-results" role="listbox" aria-labelledby="search-label"></ul>
    <p class="search-empty" id="search-empty" hidden></p>
</dialog>

<script src="/lib/chart.umd.min.js"></script>
<script src="/js/chat.js?v=34"></script>
</body>
</html>
